# Copie este arquivo para .env. Não coloque chaves no código do navegador.
# sqlite mantém os dados atuais; supabase usa exclusivamente o banco remoto.
STORAGE_PROVIDER=sqlite
PORT=3000

# Supabase > Connect / Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase > Settings > API Keys > Secret keys (uso exclusivo do servidor)
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_AQUI

# Alternativa para projetos com chave legada (não precisa preencher as duas):
# SUPABASE_SERVICE_ROLE_KEY=CHAVE_SERVICE_ROLE

# Opcionais no modo SQLite:
# DB_PATH=C:/Projetos/questionario_erico_ufrr/storage/research.sqlite
